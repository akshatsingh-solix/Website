# The backend API this site talks to (the solix-backend repository), with no
# trailing slash. In production the deploy workflow sets this from the
# BACKEND_URL repository variable; locally, point it at your running backend.
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: where the SOLIXEmpower app lives (defaults to /Website/empower/).
# REACT_APP_EMPOWER_URL=
